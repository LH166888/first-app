APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# 限流依赖持久缓存计数：生产务必用 database/redis，切勿设为 array（每请求重置，限流形同虚设）
CACHE_STORE=database
# CACHE_PREFIX=

# Sanctum token 有效期（分钟）。默认 7 天；设空或 0 需同步改 config/sanctum.php
SANCTUM_EXPIRATION_MINUTES=10080

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- 对象存储（Cloudflare R2，菜单模块图片直传）----
# 真实值不入库：本地填在 .env，生产填在 Render 环境变量。
# AWS_ENDPOINT 结尾不要带 /bucket 名（会与 AWS_BUCKET 重复导致签名 URL 出错）。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
# R2 桶的公开访问域名（形如 https://pub-xxxx.r2.dev），用于拼图片读取 URL，非密钥
R2_PUBLIC_BASE_URL=

# ---- 百度 OCR（身份证识别）----
# 控制台「文字识别 → 应用列表」里拿 API Key / Secret Key，免费额度 1000 次/月需手动领取
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---- 微信公众号模板消息（免费推送，自己/小范围用）----
# 走官方"接口测试号"：https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
# 扫码登录后拿 appID/appsecret；关注测试号后在"用户列表"拿 openid；"模板消息接口"新建模板拿 template_id
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_TEMPLATE_ID=
WECHAT_MP_DEFAULT_OPENID=

VITE_APP_NAME="${APP_NAME}"
